{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": "./SENTINEL/frontend",
    "paths": {
      "@/*": ["./SENTINEL/frontend/src/*"]
    }
  },
  "include": [
    "declarations.d.ts",
    "SENTINEL/frontend/declarations.d.ts",
    "SENTINEL/frontend/src/types/**/*.d.ts",
    "SENTINEL/frontend/src/**/*.ts",
    "SENTINEL/frontend/src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
